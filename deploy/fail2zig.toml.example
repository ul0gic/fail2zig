[global]

log_level = "info"

pid_file = "/run/fail2zig/fail2zig.pid"

socket_path = "/run/fail2zig/fail2zig.sock"

state_file = "/var/lib/fail2zig/state.bin"

memory_ceiling_mb = 64

metrics_enabled = true
metrics_bind = "127.0.0.1"
metrics_port = 9100

firewall = "auto"

on_no_backend = "fail-closed"

[defaults]

bantime = "10m"

findtime = "10m"

maxretry = 5

banaction = "nftables"

ignoreip = ["127.0.0.1/8", "::1"]


[jails.sshd]
enabled = true
filter  = "sshd"
source = "journald"
journal_executables = ["/usr/sbin/sshd", "/usr/lib/openssh/sshd-session"]
maxretry = 3
bantime  = "1h"

bantime_increment_enabled    = true
bantime_increment_multiplier = 2
bantime_increment_formula    = "exponential"
bantime_increment_max_bantime = "1w"

[jails.recidive]
enabled  = true
filter   = "recidive"
source   = "internal"
maxretry = 2
findtime = "1d"
bantime  = "1w"

[jails.nginx-http-auth]
enabled = false
filter  = "nginx-http-auth"
source = "file"
timestamp = "undated"
logpath = ["/var/log/nginx/error.log"]
ignoreip = ["192.168.0.0/16"]
