[global]

log_level = "info"

pid_file = "/run/fail2zig/fail2zig.pid"

socket_path = "/run/fail2zig/fail2zig.sock"

state_file = "/var/lib/fail2zig/state.bin"

memory_ceiling_mb = 64

metrics_enabled = true
metrics_bind = "127.0.0.1"
metrics_port = 9100

firewall = "auto"

on_no_backend = "fail-closed"

[defaults]

bantime = "10m"

findtime = "10m"

maxretry = 5

enforce = true

ignoreip = ["127.0.0.1/8", "::1"]


[jails.sshd]
enabled = true
filter  = "sshd"
source = "journald"
journal_executables = ["/usr/sbin/sshd", "/usr/lib/openssh/sshd-session"]
maxretry = 3
bantime  = "1h"

bantime_increment_enabled    = true
bantime_increment_multiplier = 2
bantime_increment_formula    = "exponential"
bantime_increment_max_bantime = "1w"

[jails.recidive]
enabled  = true
filter   = "recidive"
source   = "internal"
maxretry = 2
findtime = "1d"
bantime  = "1w"

[jails.nginx-http-auth]
enabled = false
filter  = "nginx-http-auth"
source = "file"
timestamp = "undated"
logpath = ["/var/log/nginx/error.log"]
ignoreip = ["192.168.0.0/16"]

# PortSentry 2.0.7 history-file integration. The Debian 13 standard repository
# package is legacy 1.2, which is not compatible with this filter. Run PortSentry
# in connect mode (--connect) or stealth mode (--stealth -m pcap -i <interface>,
# as root); both are qualified on Debian 13 for IPv4 and IPv6, TCP (connect, SYN,
# FIN, NULL and XMAS scans) and UDP. Configure it separately with:
#   TCP_PORTS="1,11,15"  # example; choose ports verified unused on this host
#   UDP_PORTS="1,7,9"    # optional; omit the directive for TCP only (never UDP_PORTS="")
#   HISTORY_FILE="/var/log/portsentry.log"
#   RESOLVE_HOST="0"
#   SCAN_TRIGGER="0"
#   BLOCK_TCP="0"
#   BLOCK_UDP="0"
# BLOCK_TCP=0 and BLOCK_UDP=0 leave fail2zig as the only ban owner; PortSentry still
# records every probe. Automatic bans cover the source host across all protocols and
# ports. The log is recreated by PortSentry at every start, so set on_truncation.
[jails.portsentry]
enabled = false
filter = "portsentry"
source = "file"
timestamp = "iso8601"
logpath = ["/var/log/portsentry.log"]
on_truncation = "restart"
maxretry = 1
enforce = true
