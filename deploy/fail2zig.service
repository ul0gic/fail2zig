[Unit]
Description=fail2zig — intrusion prevention system
Documentation=https://github.com/ul0gic/fail2zig https://fail2zig.com/docs
After=network-online.target rsyslog.service systemd-journald.service
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main

User=fail2zig
Group=fail2zig
ExecStart=/usr/local/bin/fail2zig --config /etc/fail2zig/config.toml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
TimeoutStopSec=10

AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_DAC_READ_SEARCH
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_DAC_READ_SEARCH
NoNewPrivileges=yes

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/fail2zig /run/fail2zig
RuntimeDirectory=fail2zig
RuntimeDirectoryMode=0710
StateDirectory=fail2zig
StateDirectoryMode=0750

ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid

RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @cpu-emulation @debug @module @mount @obsolete @raw-io @reboot @swap
SystemCallFilter=fchown

KeyringMode=private
PrivateMounts=yes

UMask=0077

[Install]
WantedBy=multi-user.target
