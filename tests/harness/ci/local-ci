#!/usr/bin/env bash
# Local trusted-trigger CI: format, plain/diag/Debug builds with the no-diag scan, a Debug rig startup and the firewall suites in parallel, then the assembled daemon lane alone.
set -uo pipefail

ROOT=$(cd "$(dirname "$0")/../../.." && pwd)
cd "$ROOT" || exit 2

usage() {
  echo "usage: local-ci [--no-tests] [--no-rig] [--out DIR]" >&2
  exit 2
}

TESTS=1
RIG=1
OUT=""
while [ $# -gt 0 ]; do
  case "$1" in
    --no-tests) TESTS=0; shift ;;
    --no-rig) RIG=0; shift ;;
    --out) OUT="${2:-}"; [ -n "$OUT" ] || usage; shift 2 ;;
    *) usage ;;
  esac
done

STAMP=$(date -u +%Y%m%dT%H%M%SZ)
OUT=${OUT:-$ROOT/.zig-cache/ci/$STAMP}
PREFIX=$ROOT/.zig-cache/ci/prefix
mkdir -p "$OUT" "$PREFIX"
RESULTS=$OUT/results.txt
: > "$RESULTS"

STEPS=(test-firewall)

record() {
  local name=$1 start=$2 code=$3
  echo "$name=$code $(( $(date +%s) - start ))s" >> "$RESULTS"
}

job() {
  local name=$1; shift
  local start; start=$(date +%s)
  "$@" > "$OUT/$name.log" 2>&1
  record "$name" "$start" $?
}

fmt() { zig fmt --check build.zig build.zig.zon engine client shared tests; }

diffcheck() { git diff --check; }

plain() {
  zig build -Doptimize=ReleaseSafe --prefix "$PREFIX/plain" &&
    zig build check-no-diag -Dcheck-binary="$PREFIX/plain/bin/fail2zig" &&
    "$PREFIX/plain/bin/fail2zig" --version
}

diag() {
  zig build -Doptimize=ReleaseSafe -Ddiag=true --prefix "$PREFIX/diag" || return 1
  "$PREFIX/diag/bin/fail2zig" --version
  if zig build check-no-diag -Dcheck-binary="$PREFIX/diag/bin/fail2zig"; then
    echo "check-no-diag passed a diag binary"
    return 1
  fi
}

debug() {
  zig build -Doptimize=Debug --prefix "$PREFIX/debug" || return 1
  [ "$RIG" = 1 ] || return 0
  local bin=$PREFIX/debug/bin/fail2zig
  tests/harness/diag/diag-run --rig --scenario empty --binary "$bin" \
    --sha256 "$(sha256sum "$bin" | cut -d' ' -f1)" --check idle --minutes 1 \
    --label "ci-debug-startup" --out "$OUT/debug-rig" || return 1
  grep -q 'storage healthy' "$OUT/debug-rig/summary.md"
}

job fmt fmt &
job diffcheck diffcheck &
job plain plain &
job diag diag &
job debug debug &
if [ "$TESTS" = 1 ]; then
  for step in "${STEPS[@]}"; do
    job "$step" zig build "$step" -Doptimize=ReleaseSafe &
  done
fi
wait
if [ "$TESTS" = 1 ]; then
  job test-ci-assembled zig build test-ci-assembled -Doptimize=ReleaseSafe -j2 --summary all
fi

sort "$RESULTS"
failed=$(grep -cv '=0 ' "$RESULTS")
echo "local-ci: $(wc -l < "$RESULTS") jobs, $failed failed; logs in $OUT"
[ "$failed" = 0 ]
