# Does:  Sends paced sshd failure lines for distinct addresses to the journal through a root-owned copy of logger.
# Holds: The emitter is a root-owned mode 0755 copy of logger at a fixed path, created only when it is missing.

set -euo pipefail
COUNT="$1"; RATE="$2"; START="${3:-0}"; PER="${4:-3}"
EMITTER=${F2Z_SSHD_EMITTER:-/usr/local/libexec/f2z-diag/sshd-emitter}
HERE=$(cd "$(dirname "$0")" && pwd)
# Why: The sshd jail takes only _TRANSPORT=syslog entries from _UID=0 with a listed _EXE, so the sender is a root copy of logger.
if [ ! -x "$EMITTER" ]; then
  install -d -m 0755 "$(dirname "$EMITTER")"
  install -o root -g root -m 0755 "$(command -v logger)" "$EMITTER"
fi
{ "$HERE/lines" sshd "$COUNT" "$RATE" --start "$START" --per-address "$PER"; sleep 5; } \
  | "$EMITTER" --tag sshd --priority auth.info --socket-errors=on
