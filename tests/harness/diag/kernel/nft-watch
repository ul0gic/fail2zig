#!/usr/bin/env bash
# Usage (root, in the daemon's network namespace): nft-watch SECONDS  — element add/delete events, prefixed by epoch seconds.
set -uo pipefail
export PATH="$PATH:/usr/sbin:/sbin"
timeout "$1" nft monitor elements | while IFS= read -r line; do
  printf '%s %s\n' "$EPOCHREALTIME" "$line"
done
