# Does:  Prints the table, set name and element count of each fail2zig nftables set.
# Holds: Only sets in tables named f2z_* are listed, so no other ruleset content is counted.

set -euo pipefail
export PATH="$PATH:/usr/sbin:/sbin"
nft -j list ruleset | python3 -I -c '
import json, sys
for item in json.load(sys.stdin)["nftables"]:
    s = item.get("set")
    if s and s["table"].startswith("f2z_"):
        print(s["table"], s["name"], len(s.get("elem", [])))
'
