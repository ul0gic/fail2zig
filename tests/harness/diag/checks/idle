#!/usr/bin/env bash
# Check: daemon CPU, readback cadence and kernel element churn over the window, with no traffic driven.
set -u
OUT="$F2Z_OUT"; K="$F2Z_HARNESS/kernel"
read -r -a NS <<< "${F2Z_NS_EXEC:-}"
"${NS[@]}" "$K/nft-count" > "$OUT/nft-start.txt" 2>&1
"${NS[@]}" "$K/nft-watch" "$F2Z_SECONDS" > "$OUT/nft-watch.log" 2>&1 &
WATCH=$!
NL=""
if [ "${F2Z_NLMON:-0}" = 1 ]; then
  "${NS[@]}" "$K/nlmon-capture" "$F2Z_SECONDS" "$OUT/netlink.pcap" > "$OUT/nlmon.txt" 2>&1 &
  NL=$!
fi
end=$((SECONDS + F2Z_SECONDS))
while [ "$SECONDS" -lt "$end" ]; do
  ticks=$(awk '{print $14+$15}' "/proc/$F2Z_PID/stat" 2>/dev/null || echo -)
  st=$("$F2Z_BIN" --socket "$F2Z_SOCK" --timeout 5000 --output json status 2>/dev/null | tr -d '\n')
  printf '%s\t%s\t%s\n' "$EPOCHREALTIME" "$ticks" "${st:--}" >> "$OUT/samples.tsv"
  sleep 1
done
wait "$WATCH"
[ -n "$NL" ] && wait "$NL"
"${NS[@]}" "$K/nft-count" > "$OUT/nft-end.txt" 2>&1
python3 -I - "$OUT" "$(getconf CLK_TCK)" "${F2Z_NLMON:-0}" <<'EOF'
import json, os, sys
out, clk, nlmon = sys.argv[1], int(sys.argv[2]), sys.argv[3] == "1"
rows = [line.rstrip("\n").split("\t", 2) for line in open(os.path.join(out, "samples.tsv"))]
alive = [(float(t), int(k)) for t, k, _ in rows if k != "-"]
def parse(s):
    try:
        return json.loads(s)
    except ValueError:
        return None
status = [(float(t), p) for t, _, s in rows if (p := parse(s)) is not None]
failed_polls = len(rows) - len(status)
died = rows[-1][1] == "-"
span = alive[-1][0] - alive[0][0] if len(alive) > 1 else 0
cpu = (alive[-1][1] - alive[0][1]) / clk / span * 100 if span else 0.0
changes = []
for t, s in status:
    c = s.get("confirmed_at_us")
    if not changes or changes[-1][1] != c:
        changes.append((t, c))
readbacks = len(changes) - 1
cadence = (changes[-1][0] - changes[1][0]) / (readbacks - 1) if readbacks > 1 else 0.0
max_age = max((s.get("knowledge_age_ms") or 0 for _, s in status), default=0)
storage = sorted({s.get("storage", "?") for _, s in status})
active = [s.get("active_bans") for _, s in status]
def total(name):
    try:
        return sum(int(line.split()[2]) for line in open(os.path.join(out, name)) if len(line.split()) == 3)
    except (OSError, ValueError):
        return None
watch = open(os.path.join(out, "nft-watch.log")).read().splitlines()
adds = sum(" add element " in line or " create element " in line for line in watch)
deletes = sum(" delete element " in line for line in watch)
nl = open(os.path.join(out, "nlmon.txt")).read().strip() if nlmon else "nlmon off"
figures = {"window_s": round(span, 1), "cpu_percent": round(cpu, 2), "readbacks": readbacks, "readback_cadence_s": round(cadence, 2),
           "max_knowledge_age_ms": max_age, "storage": storage, "failed_polls": failed_polls, "daemon_died": died,
           "active_bans_first": active[0] if active else None, "active_bans_last": active[-1] if active else None,
           "kernel_elements_start": total("nft-start.txt"), "kernel_elements_end": total("nft-end.txt"),
           "element_adds": adds, "element_deletes": deletes, "nlmon": nl}
json.dump(figures, open(os.path.join(out, "figures.json"), "w"), indent=1)
verdict = "fail" if died or storage != ["healthy"] else "info"
line = (f"{verdict}: cpu {cpu:.2f}% over {span:.0f} s; {readbacks} readbacks (every {cadence:.1f} s); "
        f"max knowledge age {max_age} ms; storage {','.join(storage)}; active {figures['active_bans_first']}->{figures['active_bans_last']}; "
        f"kernel {figures['kernel_elements_start']}->{figures['kernel_elements_end']} elements, {adds} adds, {deletes} deletes; "
        f"{failed_polls} failed polls; {nl}")
open(os.path.join(out, "result.txt"), "w").write(line + "\n")
print(line)
EOF
